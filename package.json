    "expo-secure-store": "~14.0.1",
    "expo-sqlite": "~15.1.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3"
  }
}
